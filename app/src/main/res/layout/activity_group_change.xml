<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <include layout="@layout/top_bar_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_plain"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/current_group_label"
                    android:textColor="@color/slate_500"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textCurrentGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/navy_900"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    tools:text="G01" />
            </LinearLayout>

            <!-- Pending state -->
            <LinearLayout
                android:id="@+id/pendingBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_plain"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/textPendingMove"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/navy_900"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        tools:text="Move to G02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_indigo"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/pill_pending_short"
                        android:textColor="@color/indigo_600"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/requested_note"
                    android:textColor="@color/slate_500"
                    android:textSize="12.5sp" />

                <Button
                    android:id="@+id/buttonCancelRequest"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:backgroundTint="@color/red_600"
                    android:text="@string/action_cancel_request"
                    android:textColor="@color/white"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- Choose a group -->
            <LinearLayout
                android:id="@+id/chooseBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@color/red_50"
                    android:padding="12dp"
                    android:textColor="@color/red_600"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="That group filled up. Choose another." />

                <TextView
                    style="@style/Registrar.FieldLabel"
                    android:text="@string/choose_a_group" />

                <LinearLayout
                    android:id="@+id/groupOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/group_change_note"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/buttonSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/slate_100"
                    android:enabled="false"
                    android:text="@string/action_choose_group_first"
                    android:textColor="@color/slate_400"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
