<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <!-- Top bar (matches the prototype): page-coloured, title + record count,
         solid navy initials avatar (tap = sign out), thin divider underneath -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/page_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roster_title"
                    android:textColor="@color/navy_900"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textRecordCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/slate_500"
                    android:textSize="14.5sp"
                    tools:text="6 records" />
            </LinearLayout>

            <TextView
                android:id="@+id/buttonSignOut"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_solid"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                tools:text="BN" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_200" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <!-- Search by name or student number, with a Clear (x) button, and the Filters button beside it -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/inputSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_search"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="48dp"
                    android:hint="@string/roster_search_hint"
                    android:importantForAutofill="no"
                    android:textColorHint="@color/slate_500"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />

                <ImageButton
                    android:id="@+id/buttonClearSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    android:tint="@color/slate_500"
                    android:contentDescription="@string/a11y_clear_search"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/buttonFilters"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter"
                android:src="@drawable/ic_filter"
                android:tint="@color/navy_700"
                android:contentDescription="@string/a11y_filters_none" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonFilterProgramme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:drawableEnd="@drawable/ic_chevron_down"
                android:drawableTint="@color/slate_400"
                android:textColor="@color/slate_500"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"
                tools:text="Programme: All" />

            <TextView
                android:id="@+id/buttonFilterGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:drawableEnd="@drawable/ic_chevron_down"
                android:drawableTint="@color/slate_400"
                android:textColor="@color/slate_500"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"
                tools:text="Group: All" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textResultCount"
                android:accessibilityLiveRegion="polite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/slate_500"
                android:textSize="13.5sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium"
                tools:text="6 STUDENTS" />

            <TextView
                android:id="@+id/buttonClearFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_clear"
                android:textColor="@color/navy_600"
                android:textSize="14.5sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Shown while offline: the list is only what is saved on this phone -->
        <TextView
            android:id="@+id/textCachedNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFBEB"
            android:padding="10dp"
            android:text="@string/roster_cached_notice"
            android:textColor="#92400E"
            android:textSize="13sp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStudents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="96dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/navy_900"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:accessibilityLiveRegion="polite"
                tools:text="No students match these filters" />

            <!-- Shown when a search or filter finds nobody -->
            <TextView
                android:id="@+id/buttonClearAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/roster_clear_all"
                android:textColor="@color/navy_600"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Loading state: shown while the list is being fetched -->
        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/navy_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/roster_loading"
                android:textColor="@color/slate_500"
                android:textSize="15sp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>

        <!-- Expired session state: replaces the list until the lecturer signs in again -->
        <LinearLayout
            android:id="@+id/sessionExpiredState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_expired_title"
                android:textColor="@color/navy_900"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/session_expired_body"
                android:textColor="@color/slate_500"
                android:textSize="15sp"
                android:gravity="center" />

            <Button
                android:id="@+id/buttonSessionSignIn"
                style="@style/Widget.Registrar.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="24dp"
                android:text="@string/session_expired_action" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/fabAdd"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_fab_circle"
            android:src="@drawable/ic_add"
            android:scaleType="center"
            android:elevation="6dp"
            android:contentDescription="@string/action_add_student" />
    </FrameLayout>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
