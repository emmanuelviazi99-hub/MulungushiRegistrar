<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_change_password"
            android:textColor="@color/navy_900"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/change_password_hint"
            android:textColor="@color/slate_500"
            android:textSize="14.5sp" />

        <TextView android:labelFor="@+id/inputCurrent"
            style="@style/Registrar.FieldLabel"
            android:text="@string/label_current_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCurrent"
            style="@style/Widget.Registrar.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:endIconDrawable="@drawable/sel_eye"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/slate_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCurrent"
                style="@style/Widget.Registrar.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/hint_current_password"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:labelFor="@+id/inputNew"
            style="@style/Registrar.FieldLabel"
            android:text="@string/label_new_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNew"
            style="@style/Widget.Registrar.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:endIconDrawable="@drawable/sel_eye"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/slate_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNew"
                style="@style/Widget.Registrar.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/hint_password_create"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:labelFor="@+id/inputConfirm"
            style="@style/Registrar.FieldLabel"
            android:text="@string/label_confirm_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutConfirm"
            style="@style/Widget.Registrar.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:endIconDrawable="@drawable/sel_eye"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/slate_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputConfirm"
                style="@style/Widget.Registrar.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/hint_confirm_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSheetCancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/slate_100"
                android:text="@string/action_close"
                android:textAllCaps="false"
                android:textColor="@color/navy_900"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonSheetUpdate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/navy_600"
                android:text="@string/action_update_password"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
