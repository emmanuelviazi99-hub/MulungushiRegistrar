<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 11 and older (see data_extraction_rules.xml for 12+).
     The sign-in token (shared_prefs/session.xml) never leaves the phone. -->
<full-backup-content>
    <exclude domain="sharedpref" path="session.xml" />
</full-backup-content>
