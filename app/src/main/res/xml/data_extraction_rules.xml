<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and newer. The sign-in token (shared_prefs/session.xml)
     is left out of cloud backups and of copying to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
