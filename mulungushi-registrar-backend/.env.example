# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.
#
# IMPORTANT: if a value contains a # character, wrap it in double quotes
# ("like#this"). Without quotes dotenv treats everything after # as a comment
# and silently cuts the value short.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=registrar_app
DB_PASSWORD=change_me
DB_NAME=mulungushi_registrar
DB_CONNECTION_LIMIT=10

# --- Auth ---
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if this is missing or shorter than 32 characters.
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=12h
# Optional: a separate secret used to hash verification codes. Defaults to JWT_SECRET.
# CODE_PEPPER=

# --- How verification codes are delivered ---
# email    Nodemailer sends the code through the SMTP account below (the normal setting)
# sms      ALSO texts it through Twilio (optional; needs the TWILIO_* values below)
# console  prints it in this terminal instead — only for working with no mail
#          account at all; the server refuses to start in production with it
# Combine with a comma:  CODE_DELIVERY=email,sms
CODE_DELIVERY=email

# --- SMTP account that sends the codes (Nodemailer) ---
# The server will not start with CODE_DELIVERY=email until these are filled in.
# After filling them in, check them with:   npm run email:test -- you@example.com
#
# Option A — a Gmail account (free; fine for the project and demos):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Google Account > Security > 2-Step Verification > App passwords:
#      create one called "Mulungushi Registrar" and copy the 16 letters.
#   3. Use these values (SMTP_PASS is the app password, NOT your Gmail password):
#        SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   SMTP_SECURE=true
#        SMTP_USER=yourname@gmail.com   SMTP_FROM="Mulungushi Registrar <yourname@gmail.com>"
#
# Option B — Mailtrap (https://mailtrap.io, free "Email Testing" inbox): every
#   email is caught in a web inbox instead of really being sent — handy while
#   testing with made-up addresses. Copy host/port/user/pass from the inbox's
#   SMTP settings, e.g. SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=587  SMTP_SECURE=false
#
# Option C — the university's own mail server: ask ICT for the host, port and an account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourname@gmail.com
SMTP_PASS=
SMTP_FROM="Mulungushi Registrar <yourname@gmail.com>"

# --- Optional: SMS through Twilio (https://www.twilio.com) ---
# Only used if CODE_DELIVERY includes sms. TWILIO_FROM is your Twilio phone number
# (+1...) or a Messaging Service SID (MG...). A Twilio trial account can only text
# phone numbers you have verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Demo lecturer account (used only by `npm run seed:accounts`) ---
SEED_LECTURER_EMAIL=b.nyirenda@mulungushi.edu.zm
SEED_LECTURER_EMPLOYEE_ID=EMP-1001
SEED_LECTURER_NAME=Bwalya Nyirenda
SEED_LECTURER_PASSWORD="Lecturer#2025"

# --- Tests only: a throwaway database the test suite may DROP and recreate ---
TEST_DB_NAME=mulungushi_registrar_test
