# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=registrar_app
DB_PASSWORD=change_me
DB_NAME=mulungushi_registrar
DB_CONNECTION_LIMIT=10

# --- Auth ---
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=12h

# --- Demo lecturer account (used only by `npm run seed:accounts`) ---
SEED_LECTURER_USERNAME=lecturer1
SEED_LECTURER_PASSWORD=Lecturer#2025
