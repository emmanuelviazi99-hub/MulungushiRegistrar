<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash first; make it navy with no icon so ours takes over cleanly -->
    <style name="Theme.Registrar.Splash" parent="Theme.Registrar">
        <item name="android:windowBackground">@color/navy_900</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/navy_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/navy_900</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
